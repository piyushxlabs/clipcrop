# ==============================================================================
# ClipCrop Environment Configuration Template
# ==============================================================================
# All paths should be absolute paths on the local system.
# No cloud APIs or external network egress are used at runtime.

# Sandboxed directory for uploaded raw videos
CLIPCROP_UPLOAD_DIR=/absolute/path/to/clipcrop/uploads

# Sandboxed directory for rendered vertical clips and exported NLE files (.edl, .xml, .json)
CLIPCROP_OUTPUT_DIR=/absolute/path/to/clipcrop/outputs

# Directory containing offline model weights (faster-whisper, MediaPipe .task, Silero VAD)
CLIPCROP_MODELS_DIR=/absolute/path/to/clipcrop/models

# System executable paths for ffmpeg and ffprobe
CLIPCROP_FFMPEG_PATH=ffmpeg
CLIPCROP_FFPROBE_PATH=ffprobe

# Confidence Gate Threshold for speaker tracking (0.0 to 1.0)
CLIPCROP_CONFIDENCE_THRESHOLD=0.65

# Maximum number of candidate segments fanned out for tracking per run
CLIPCROP_MAX_CANDIDATES=10

# Hard wall-clock execution time budget in seconds
CLIPCROP_TIME_BUDGET_SECONDS=90

# Sandboxed directory for local OpenTelemetry JSON span traces
CLIPCROP_TRACE_LOG_DIR=/absolute/path/to/clipcrop/outputs/traces
